    },
    "comparisons": [
      {
        "id": "path_score_beam_vs_shortest_path",
        "family": "path",
        "left": "score_beam",
        "right": "shortest_path",
        "metrics": ["answer_hit", "top1_hit"]
      },
      {
        "id": "path_terminal_vs_score_beam",
