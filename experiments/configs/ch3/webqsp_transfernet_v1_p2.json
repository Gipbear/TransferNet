      "fixed": "data/output/kgqa/ch3_retrieval/webqsp/transfernet/penalty_ablations/transfernet_v1/fixed/test.jsonl",
      "adaptive": "data/output/kgqa/ch3_retrieval/webqsp/transfernet/penalty_ablations/transfernet_v1/adaptive/test.jsonl"
