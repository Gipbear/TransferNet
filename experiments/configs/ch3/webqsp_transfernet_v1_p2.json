        "left": "terminal_score_beam",
        "right": "score_beam",
        "metrics": ["answer_hit", "top1_hit"]
      },
      {
        "id": "path_adaptive_vs_fixed",
        "family": "path",
        "left": "adaptive",
        "right": "fixed",
        "metrics": ["answer_hit", "top1_hit"]
      },
      {
        "id": "path_adaptive_vs_terminal",
        "family": "path",
        "left": "adaptive",
        "right": "terminal_score_beam",
        "metrics": ["answer_hit", "top1_hit"]
      },
      {
        "id": "qa_terminal_vs_score_beam",
        "family": "qa",
        "left": "terminal_score_beam",
        "right": "score_beam",
        "metrics": ["hit1"]
      },
      {
        "id": "qa_tarrs_vs_terminal",
        "family": "qa",
        "left": "tarrs",
        "right": "terminal_score_beam",
        "metrics": ["hit1"]
      },
      {
        "id": "qa_tarrs_vs_no_path",
        "family": "qa",
        "left": "tarrs",
        "right": "no_path",
        "metrics": ["hit1"]
      },
      {
        "id": "qa_adaptive_vs_fixed",
        "family": "qa",
        "left": "tarrs",
        "right": "fixed",
        "metrics": ["macro_f1", "hit1"]
      }
    ]
  },
  "efficiency": {
