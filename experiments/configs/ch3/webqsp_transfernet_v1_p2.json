      },
      {
        "id": "adaptive",
        "kind": "score_beam",
        "params": {
          "beam_size": 20,
          "lambda_val": 0.2,
          "threshold": 0.01,
          "eta": 1.0,
          "step_score_mode": "joint",
          "penalty_mode": "adaptive"
