      "build_args": [
        "--format", "v2",
        "--path_format", "chain",
        "--entity_repr", "name"
      ],
      "train_args": [
        "--model", "unsloth/Meta-Llama-3.1-8B-Instruct-unsloth-bnb-4bit",
        "--model_precision", "4bit",
        "--lora_rank", "16",
        "--lora_alpha", "32",
        "--lr", "2e-4",
        "--batch_size", "1",
        "--grad_accum", "32",
        "--epochs", "2",
        "--max_seq_len", "1280"
      ],
      "eval_args": [
        "--format", "v2",
        "--path_format", "chain",
        "--entity_repr", "name",
        "--max_paths", "20",
        "--batch_size", "1",
        "--model", "unsloth/Meta-Llama-3.1-8B-Instruct-unsloth-bnb-4bit",
        "--model_precision", "4bit",
        "--max_seq_length", "2048",
        "--max_new_tokens", "256"
      ]
    }
  ]
