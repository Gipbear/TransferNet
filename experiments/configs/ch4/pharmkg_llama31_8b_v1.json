{
  "schema_version": 1,
  "kind": "ch4_pfit_matrix",
  "dataset": "pharmkg",
  "config_id": "llama31_8b_v1",
  "note": "PharmKG 的 Llama 3.1 8B Instruct 路径监督微调主实验。未微调基线与微调组复用同一 RSDPR 路径、提示格式和确定性解码，仅比较是否加载 PharmKG QLoRA adapter。",
  "experiments": [
